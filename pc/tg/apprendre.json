  "missions": {
   "pwd": "^pwd\\b",
   "ls": "^ls\\s+-\\w*a",
   "cd": "^cd\\s+/\\s*$",
   "mkdir": "^mkdir\\s+-p\\s+\\S+/\\S+",
   "touch": "^touch\\s+\\S+\\s+\\S+",
   "cp": "^cp\\s+-\\w*r",
   "mv": "^mv\\s+\\S+\\s+\\S+",
   "rm": "^rm\\s+-\\w*i",
   "cat": "^cat\\s+-\\w*n",
   "less": "^less\\s+\\S+",
   "head": "^head\\s+(-n\\s*3|-3)\\b",
   "grep": "^grep\\s+-\\w*i",
   "find": "^find\\s.*-name\\s",
   "wc": "^wc\\s+-\\w*l",
   "sort": "^sort\\s+-\\w*r",
   "tree": "^tree\\s+-L\\s*\\d",
   "rev": "^rev\\s+\\S+",
   "whoami": "^whoami\\b",
   "date": "^date\\s+\\+",
   "chmod": "^chmod\\s+[0-7]{3}\\s"
  },
  "exemples": {
   "pwd": "pwd",
   "ls": "ls -a",
   "cd": "cd /",
   "mkdir": "mkdir -p cabane/grenier/coffre",
   "touch": "touch pomme.txt poire.txt",
   "cp": "cp -r cabane cabane_copie",
   "mv": "mv pomme.txt panier.txt",
   "rm": "rm -i poire.txt",
   "cat": "cat -n recette.txt",
   "less": "less recette.txt",
   "head": "head -n 3 recette.txt",
   "grep": "grep -i miel recette.txt",
   "find": "find . -name \"*.txt\"",
   "wc": "wc -l recette.txt",
   "sort": "sort -r recette.txt",
   "tree": "tree -L 2",
   "rev": "rev recette.txt",
   "whoami": "whoami",
   "date": "date +%Y",
   "chmod": "chmod 600 pomme.txt"
  }
