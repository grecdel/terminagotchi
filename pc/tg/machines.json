  "note": "les commandes qui interrogent chaque pièce (expressions sur un morceau de ligne) : la pièce s'allume dans l'ordinateur ouvert (machines ouvre, vue déployée)",
  "processeur": ["^nproc\\b", "^lscpu\\b", "/proc/cpuinfo", "^getprop\\b.*(cpu|abi|hardware)", "^(tg\\s+)?machines\\s+coeurs\\b"],
  "memoire": ["^free\\b", "/proc/meminfo", "^vmstat\\b", "^(tg\\s+)?machines\\s+memoire\\b"],
  "stockage": ["^lsblk\\b", "^df\\b", "^du\\b", "^stat\\b", "^findmnt\\b", "/proc/partitions"],
  "carte_mere": ["^lspci\\b", "^lsmod\\b", "^getprop\\b.*(model|board|product)", "/sys/class/dmi\\b"],
  "graphique": ["^lspci\\b.*(vga|3d|display|graph)", "^glxinfo\\b", "^xrandr\\b"],
  "usb": ["^lsusb\\b", "/sys/bus/usb\\b"],
  "alimentation": ["^uptime\\b", "/proc/uptime", "/sys/class/power_supply\\b", "^upower\\b", "^acpi\\b"]
 },
