 "scripts": {
  "fragile": [
   "#!/usr/bin/env bash",
   "# ##som.sc.fragile.role##",
   "carnet=$1",
   "cp $carnet coffre/",
   "echo @@som.sc.fragile.ok@@ \"$carnet\""
  ],
  "sale": [
   "#!/usr/bin/env bash",
   "# ##som.sc.sale.role##",
   "brouillon=$(mktemp ./brouillon.XXXXXX)",
   "echo @@som.sc.ration@@ 1 >> \"$brouillon\"",
   "echo @@som.sc.sale.panne@@ >&2",
   "exit 1"
  ],
  "bivouac": [
   "#!/usr/bin/env bash",
   "# ##som.sc.bivouac.role##",
   "set -euo pipefail",
   "n=2",
   "usage() { echo @@som.sc.bivouac.usage@@ >&2; }",
   "while getopts \"n:h\" opt; do",
   "  case $opt in",
   "    n) n=$OPTARG ;;",
   "    h) usage; exit 0 ;;",
   "    *) usage; exit 2 ;;",
   "  esac",
   "done",
   "brouillon=$(mktemp ./brouillon.XXXXXX)",
   "trap 'rm -f \"$brouillon\"' EXIT",
   "i=1",
   "while [ \"$i\" -le \"$n\" ]; do",
   "  echo @@som.sc.ration@@ \"$i\" >> \"$brouillon\"",
   "  i=$((i + 1))",
   "done",
   "cp \"$brouillon\" sac.txt",
   "echo @@som.sc.bivouac.ok@@ \"$n\""
  ],
  "casse": [
   "#!/usr/bin/env bash",
   "# ##som.sc.casse.role##",
   "marches=0",
   "for etage in 1 2 3 4; do",
   "  marches=$((marches + etage * 10))",
   "  if [ \"$marches\" -gt 50 ]",
   "    echo @@som.sc.casse.plus@@ \"$etage\"",
   "  fi",
   "done",
   "echo @@som.sc.total@@ \"$marches\""
  ],
  "boucle": [
   "#!/usr/bin/env bash",
   "# ##som.sc.boucle.role##",
   "total=0",
   "for alt in 1200 1850 2400; do",
   "  totl=$((total + alt))",
   "done",
   "echo @@som.sc.boucle.cumul@@ \"$total\""
  ]
 },
