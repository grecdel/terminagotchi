<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fond"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#55000000">

    <LinearLayout
        android:id="@+id/panneau"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        android:background="@drawable/panneau"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/creature"
                android:layout_width="84dp"
                android:layout_height="76dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titre"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texte"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/faim"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/vert"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/xp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/texte_doux"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/stats"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/texte_doux"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lexique_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginEnd="4dp"
                android:background="@drawable/touche"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="📖 Lexique"
                android:textColor="@color/texte"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/fermer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:padding="6dp"
                android:text="✕"
                android:textColor="@color/texte_doux"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bulle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bulle"
            android:padding="8dp"
            android:textColor="#1e1e2e"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lecon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/rose"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/observatoire_fond"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/chemin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:maxLines="1"
                android:textColor="#d7d7ff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
            android:focusable="false"
            android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/contenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp">

            <ScrollView
            android:focusable="false"
            android:descendantFocusability="blocksDescendants"
                android:id="@+id/defile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/terminal_fond"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/sortie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="#d0d0d0"
                    android:textSize="12sp" />
            </ScrollView>

            <ScrollView
            android:focusable="false"
            android:descendantFocusability="blocksDescendants"
                android:id="@+id/lexique_vue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/terminal_fond"
                android:fadeScrollbars="false"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lexique_texte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:padding="8dp"
                    android:textSize="12sp" />
            </ScrollView>
        </FrameLayout>

        <HorizontalScrollView
            android:focusable="false"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/touches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/invite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/vert"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/saisie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="monospace"
                android:hint="@string/saisie_indice"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions|textVisiblePassword"
                android:maxLines="1"
                android:textColor="#ffffff"
                android:textColorHint="#55557a"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/envoyer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:text="⏎"
                android:textColor="@color/vert"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
