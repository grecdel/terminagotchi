<?xml version="1.0" encoding="utf-8"?>
<!-- La notification en direct, dépliée (NotifVie) : la créature en grand, son nom, ses jauges, son humeur, sa phrase.
     Les couleurs de texte viennent des styles de notification d'Android : lisibles en thème clair comme sombre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/n_creature"
        android:layout_width="96dp"
        android:layout_height="85dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/n_titre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

        <TextView
            android:id="@+id/n_jauges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />

        <TextView
            android:id="@+id/n_humeur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />

        <TextView
            android:id="@+id/n_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textStyle="italic" />
    </LinearLayout>
</LinearLayout>
